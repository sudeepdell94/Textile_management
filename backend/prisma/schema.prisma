generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

enum MachineStatus {
  ON
  OFF
}

enum WorkerStatus {
  Present
  Leave
}

enum DayOfWeek {
  Sun
  Mon
  Tue
  Wed
  Thu
  Fri
  Sat
}

model Worker {
  id            Int            @id @default(autoincrement())
  name          String
  dob           DateTime?
  dailySalary   Float          @default(0)

  isActive      Boolean        @default(true)

  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  workerRecords WorkerRecord[]
}

model WorkerRecord {
  id            Int          @id @default(autoincrement())

  workerId      Int
  worker        Worker       @relation(fields: [workerId], references: [id])

  workerName    String

  date          DateTime
  dayOfWeek     DayOfWeek

  status        WorkerStatus @default(Present)

  advance       Float        @default(0)
  salaryBefore  Float
  salaryAfter   Float
  netSalary     Float

  createdAt     DateTime     @default(now())
}

model Production {
  id               Int            @id @default(autoincrement())

  machineId        String

  date             DateTime
  dayOfWeek        DayOfWeek

  sareesProduced   Int            @default(0)
  warpingCapacity  Int?

  costPerSaree     Float          @default(0)
  totalCost        Float          @default(0)

  machineStatus    MachineStatus  @default(ON)

  createdAt        DateTime       @default(now())
}